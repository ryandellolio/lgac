# Copy to .env and fill in. .env is gitignored.

# Personal Access Token from https://connect-pat.lgthinq.com
# (sign in with the LG ThinQ account your ACs are registered to;
#  Add New Token; grant device view/state + device control scopes)
LGAC_PAT=

# Two-letter country of your LG ThinQ account. US -> region api-aic.
LGAC_COUNTRY=US

# Any stable UUID identifying this client. Generate once, e.g.:
#   node -e "console.log(crypto.randomUUID())"
LGAC_CLIENT_ID=

# Optional. Your electricity price per kWh; adds a cost column to the TUI's Energy view.
# LGAC_KWH_RATE=0.18
